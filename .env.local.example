# Copy to .env.local. Never commit actual credentials.
# Public GitHub username, read only by the server. No GitHub token is needed.
GITHUB_USERNAME=roselller

# Neon pooled runtime URL (hostname contains -pooler).
DATABASE_URL=
# Neon direct connection URL, used only for migrations.
DATABASE_URL_UNPOOLED=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate once: openssl rand -hex 32
RATE_LIMIT_SALT=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional comma-separated trusted HTTPS hosts for project images.
NEXT_PUBLIC_IMAGE_HOSTS=
