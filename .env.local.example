# Copy to .env.local. Never commit actual credentials.
# Public GitHub username, read only by the server. No GitHub token is needed.
GITHUB_USERNAME=roselller

# Runtime URL: Neon POOLED URL (host contains -pooler) for the limited
# "portfolio_app" user that can only insert into messages. This is the only
# database variable that goes on Vercel (Production only, type Secret).
# See docs/deployment.md. Leave empty locally so dev never writes to production.
DATABASE_URL=
# Owner's DIRECT Neon URL, for `pnpm db:migrate` and `pnpm db:prune` only.
# Keep it in .env.local. Never add it to Vercel.
DATABASE_URL_UNPOOLED=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate once: openssl rand -hex 32
RATE_LIMIT_SALT=

# Contact form email notifications (https://resend.com).
RESEND_API_KEY=
# Where new messages are emailed. Until you verify a domain in Resend, this must
# be the email address of your Resend account.
CONTACT_TO_EMAIL=
# Optional. Defaults to "Portfolio <onboarding@resend.dev>". Set it once you have
# verified your own domain in Resend.
CONTACT_FROM_EMAIL=

# Optional. On Vercel this falls back to the production domain automatically, so
# do not copy the localhost value below into Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional comma-separated trusted HTTPS hosts for project images.
NEXT_PUBLIC_IMAGE_HOSTS=
